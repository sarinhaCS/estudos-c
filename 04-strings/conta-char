#include <stdio.h>

int main()
{
    char frase[200];
    int cont = 0;
    int i = 0;

    printf("Digite uma frase: ");
    fgets(frase, sizeof(frase), stdin);

    while (frase[i] != '\0' && frase[i] != '\n') {
        cont++;
        i++;
    }

    printf("A frase tem %d caracteres.\n", cont);

    return 0;
}
